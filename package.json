{
  "name": "plo-syntax-lab-mcp",
  "version": "0.4.2",
  "private": true,
  "description": "Local MCP access to the PLO Syntax Lab engine and Windows comparison runtime",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mcp": "node mcp/server.mjs",
    "test:mcp": "node --test tests/mcp.test.mjs",
    "package:windows-mcp": "node mcp/package-runtime.cjs",
    "test:research": "node --test --test-concurrency=1 tests/research-mcp.test.mjs tests/generated-research.test.mjs",
    "test:codex-setup": "node --test tests/codex-setup.test.mjs",
    "test:directory": "node --test tests/research-directory.test.mjs",
    "test:generated": "node --test tests/generated-conditions.test.mjs tests/generated-plan-guards.test.mjs",
    "preview:generated": "node mcp/preview-generated-conditions.mjs",
    "test:sd-rank": "node --test tests/sd-rank-study.test.cjs",
    "research:sd-rank": "node mcp/sd-rank-study.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
